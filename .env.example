# ========================================================
# AMMORA PROTOCOL SEASON 2 CONFIGURATION (.env)
# ========================================================

# --------------------------------------------------------
# PILIHAN 1: FULL AUTO MODE (Direkomendasikan)
# --------------------------------------------------------
# Masukkan Private Key wallet Anda untuk eksekusi 100% otomatis:
# (Check-in + Vault Deposit On-chain + 5x DEX Swaps On-chain + Staking)
# Format: 64 karakter heksadesimal (dengan atau tanpa 0x)
PRIVATE_KEY=

# --------------------------------------------------------
# PILIHAN 2: COOKIE-ONLY MODE (Aman Tanpa Private Key)
# --------------------------------------------------------
# Jika Anda HANYA ingin bot menjalankan misi off-chain:
# (Daily Check-in + 7 Misi Sosial + Weekly Post) tanpa risiko Private Key,
# kosongkan PRIVATE_KEY dan isi AMMORA_COOKIE serta WALLET_ADDRESS di bawah ini:
# Ambil cookie dari DevTools browser: Application -> Cookies -> https://ammora.org -> ammora_s2_auth
AMMORA_COOKIE=
WALLET_ADDRESS=

# --------------------------------------------------------
# PENGATURAN OPSIONAL
# --------------------------------------------------------
# Proxy HTTP/HTTPS tunggal (atau gunakan file proxy.txt untuk banyak proxy)
PROXY_URL=

# GIWA Sepolia Testnet RPC URL
GIWA_RPC_URL=https://sepolia-rpc.giwa.io
